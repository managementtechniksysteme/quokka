# Docker-only secrets: values with no Laravel .env equivalent, injected
# straight into specific containers via docker-compose.yml's env_file: (not
# used for ${VAR} substitution in the compose file itself). Copy this to
# .env.docker (gitignored) and fill in real values.

# MariaDB's root superuser password -- not the app's own DB_PASSWORD, which
# already comes from the shared .env.
MYSQL_ROOT_PASSWORD=change-me

# Cloudflare API token for docker/caddy/Caddyfile.prod's DNS-01 challenge.
# Only actually read once Caddyfile.prod is the one mounted by the caddy
# service -- harmless to leave blank otherwise.
CF_API_TOKEN=
