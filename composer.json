{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/laravel-shift/spotlight.git"
        },
        {
            "url": "https://github.com/managementtechniksysteme/laravel-pdf-latex.git",
            "type": "git"
        }
    ],
    "require": {
        "php": "^8.4",
        "chillerlan/php-qrcode": "^6.0",
        "graham-campbell/markdown": "^16.0",
        "laravel-notification-channels/webpush": "^10.0",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "league/commonmark": "^2.4",
        "loilo/fuse": "^7.0",
        "managementtechniksysteme/laravel-pdf-latex": "^1.0",
        "pragmarx/google2fa": "^9.0",

        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-collection-macros": "^8.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-permission": "^7.0",
        "ueberdosis/pandoc": "^0.9",
        "wire-elements/spotlight": "dev-l13-compatibility"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "barryvdh/laravel-ide-helper": "^3.0",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.4",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "check-style": [
            "php-cs-fixer fix --dry-run --diff",
            "./node_modules/.bin/prettier --check 'resources/**/*.blade.php'",
            "./node_modules/.bin/prettier --check 'resources/**/*.vue'",
            "./node_modules/.bin/prettier --check 'resources/**/*.js'",
            "./node_modules/.bin/prettier --check 'resources/**/*.scss'"
        ],
        "fix-style": [
            "php-cs-fixer fix",
            "./node_modules/.bin/prettier --write 'resources/**/*.blade.php'",
            "./node_modules/.bin/prettier --write 'resources/**/*.vue'",
            "./node_modules/.bin/prettier --write 'resources/**/*.js'",
            "./node_modules/.bin/prettier --write 'resources/**/*.scss'"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
