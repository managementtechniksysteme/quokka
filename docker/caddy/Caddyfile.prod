# Prod starting point -- not wired into docker-compose.yml's default mount
# (that's a real deploy-time decision). Adapted from the queue task's pasted
# reference draft: corrected the upstream to this app's actual php-fpm
# service name, added the Cloudflare DNS-01 challenge block (needs
# caddybuilds/caddy-cloudflare specifically, not plain Caddy), and the same
# request_body limit the dev Caddyfile has.
{
	email your-email@example.com
	servers {
		protocols h1 h2 h3
	}
}

your-domain.com {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	root * /var/www/public

	encode gzip

	request_body {
		max_size 20MB
	}

	php_fastcgi php-fpm:9000

	@static {
		file
		path *.css *.js *.ico *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	file_server
}
